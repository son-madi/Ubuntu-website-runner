{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "prestart": "node -e \"const fs = require('fs'); const cp = require('child_process'); if (!fs.existsSync('dist/server.cjs') || !fs.existsSync('dist/index.html')) { console.log('[Auto-Build] Building website and server...'); cp.execSync('npm run build', { stdio: 'inherit' }); }\"",
    "start": "node --expose-gc --max-old-space-size=384 index.js",
    "clean": "node -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }); } catch {}\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "canvas": "^3.2.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^0.546.0",
    "mineflayer": "^4.39.0",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "motion": "^12.23.24",
    "prismarine-viewer": "^1.33.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
